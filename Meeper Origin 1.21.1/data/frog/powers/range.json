{
    "name": "Tongue Only",
    "description": "Your attack range is +1 but your block place range is -1",
    "type": "origins:multiple",
    "apply": {
        "type": "origins:action_over_time",
        "interval": 20,
        "entity_action": {
            "type": "origins:and",
            "actions": [
                {
                    "type": "origins:execute_command",
                    "command": "scale set pehkui:block_reach 0.7778 @s"
                },
                {
                    "type": "origins:execute_command",
                    "command": "scale set pehkui:entity_reach 1.3333 @s"
                }
            ]
        }
    },
    "setup": {
        "type": "origins:action_on_callback",
        "entity_action_chosen": {
            "type": "origins:and",
            "actions": [
                {
                    "type": "origins:execute_command",
                    "command": "scale set pehkui:block_reach 0.7778 @s"
                },
                {
                    "type": "origins:execute_command",
                    "command": "scale set pehkui:entity_reach 1.3333 @s"
                }
            ]
        },
        "execute_chosen_when_orb": true,
        "entity_action_lost": {
            "type": "origins:and",
            "actions": [
                {
                    "type": "origins:execute_command",
                    "command": "scale reset pehkui:block_reach @s"
                },
                {
                    "type": "origins:execute_command",
                    "command": "scale reset pehkui:entity_reach @s"
                }
            ]
        }
    }
}
