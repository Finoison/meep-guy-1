{
    "name": "Borrowed Body",
    "description": "This body is only yours for 30 minutes. The hourglass bar drains as time passes, and when it empties the swamp takes the form back and you sink to a tadpole again, the frog gods reclaiming it.",
    "type": "origins:multiple",
    "meter": {
        "type": "origins:resource",
        "min": 0,
        "max": 1800,
        "start_value": 1800,
        "hud_render": {
            "should_render": true,
            "sprite_location": "origins:textures/gui/community/spiderkolo/resource_bar_03.png",
            "bar_index": 9,
            "icon_index": 0
        }
    },
    "tick": {
        "type": "origins:action_over_time",
        "interval": 20,
        "entity_action": {
            "type": "origins:change_resource",
            "resource": "frog:form_timer_meter",
            "change": -1
        }
    },
    "expire": {
        "type": "origins:action_over_time",
        "interval": 20,
        "condition": {
            "type": "origins:resource",
            "resource": "frog:form_timer_meter",
            "comparison": "<=",
            "compare_to": 0
        },
        "entity_action": {
            "type": "origins:and",
            "actions": [
                {
                    "type": "origins:change_resource",
                    "resource": "frog:form_timer_meter",
                    "change": 1800,
                    "operation": "set"
                },
                {
                    "type": "origins:execute_command",
                    "command": "title @s actionbar {\"text\":\"The pond calls you back...\",\"color\":\"dark_green\"}"
                },
                {
                    "type": "origins:execute_command",
                    "command": "origin set @s origins:origin frog:tadpole"
                }
            ]
        }
    },
    "reset": {
        "type": "origins:action_on_callback",
        "entity_action_chosen": {
            "type": "origins:change_resource",
            "resource": "frog:form_timer_meter",
            "change": 1800,
            "operation": "set"
        },
        "execute_chosen_when_orb": true,
        "entity_action_lost": {
            "type": "origins:change_resource",
            "resource": "frog:form_timer_meter",
            "change": 1800,
            "operation": "set"
        }
    }
}
